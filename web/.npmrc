# Hard-fail any npm command run with a toolchain that violates package.json
# "engines" (node >= 24). The system node writes lockfiles that the pinned
# node's npm ci rejects; this turns npm's default EBADENGINE warning into an
# error so the wrong toolchain cannot touch this package at all.
engine-strict=true

# No package may run code at install time. npm ci runs on a long-lived
# self-hosted runner, so an install script in any transitive dependency would
# be arbitrary code execution on the CI host — the delivery mechanism for most
# npm supply-chain attacks. Nothing here needs one (sharp ships prebuilt
# binaries as optional dependencies), so the capability is simply removed.
ignore-scripts=true
